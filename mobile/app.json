{
  "expo": {
    "name": "NOVA",
    "slug": "nova",
    "owner": "qureshi-1s-team",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.nova.companion",
      "versionCode": 2,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "INTERNET",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NOVA needs the microphone to hear you, Captain.",
          "speechRecognitionPermission": "NOVA uses speech recognition to take your voice commands, Captain."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9821781a-03cd-4f26-981a-7255a443b2a2"
      }
    }
  }
}
