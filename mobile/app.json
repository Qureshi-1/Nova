{
  "expo": {
    "name": "NOVA",
    "slug": "nova",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.nova.companion",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "INTERNET",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NOVA needs the microphone to hear you, Captain.",
          "speechRecognitionPermission": "NOVA uses speech recognition to take your voice commands, Captain."
        }
      ]
    ]
  }
}
